#!/usr/bin/env bash
# Run a Windows program in the Adobe Wine prefix with the chosen Wine (by default the
# patched runner; see lib/paths.sh for the installer's settings).
#   adobe-wine PROGRAM.exe [ARGS...]      (any wine command works: winecfg, regedit, ...)
# Environment overrides: ADOBE_WINE_PREFIX, ADOBE_WINE_NO_OFFLOAD=1 (virtual displays),
# ADOBE_WINE_IM=1 (keep the ibus/fcitx input method).
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
# shellcheck source=../lib/paths.sh
source "$here/../lib/paths.sh"
base=$ADOBE_WINE_HOME
files=$RUNNER_FILES
export WINEPREFIX="${ADOBE_WINE_PREFIX:-$DEFAULT_PREFIX}"
export WINE="$WINE_BIN" WINESERVER="$WINESERVER_BIN"
[[ "$files" == /usr ]] || export PATH="$files/bin:$PATH"
export WINEDEBUG="${WINEDEBUG:--all}"
if [[ ! -x "$WINE" ]]; then
    printf 'The Wine for Adobe apps is missing: %s\nRun the installer (install.sh) again.\n' "$WINE" >&2
    exit 1
fi

# Fonts (lib/fonts.sh): DirectWrite's last-resort Tahoma missing from the registry (Direct2D
# programs draw no text), fonts installed or removed on the desktop since the last start
# (Adobe apps must list them afresh), or a Wine font substitute hiding an installed font.
if [[ -n "${1:-}" && -z "${ADOBE_WINE_FONTFIX:-}" && -f "$here/../lib/fonts.sh" ]]; then
    # shellcheck source=../lib/fonts.sh
    source "$here/../lib/fonts.sh"
    if fonts_need_update "$WINEPREFIX"; then
        ADOBE_WINE_PREFIX="$WINEPREFIX" "$here/ae-linux" fonts "$WINEPREFIX" >/dev/null 2>&1 || true
    fi
fi

# Library layout the Proton script normally sets up (GStreamer/FFmpeg for Media Foundation).
lib="$files/lib"
export ORIG_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
if [[ "$files" != /usr && -d "$lib/x86_64-linux-gnu" ]]; then     # Proton builds only
    export LD_LIBRARY_PATH="$lib/x86_64-linux-gnu:$lib/i386-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export WINEDLLPATH="$lib/vkd3d:$lib/wine:$lib/wine/nvidia-libs/nvml/wine"
    export GST_PLUGIN_SYSTEM_PATH_1_0="$lib/x86_64-linux-gnu/gstreamer-1.0:$lib/i386-linux-gnu/gstreamer-1.0"
fi
export WINE_GST_REGISTRY_DIR="$base/cache/gstreamer-1.0"

# Render OpenGL, EGL, Vulkan and CUDA on the NVIDIA GPU of hybrid laptops.
if [[ -z "${ADOBE_WINE_NO_OFFLOAD:-}" && "${ADOBE_WINE_NVIDIA:-1}" != 0 ]] && [[ -e /dev/nvidiactl ]]; then
    export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia
    export __VK_LAYER_NV_optimus=NVIDIA_only
    [[ -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]] &&
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
    [[ -e /usr/share/vulkan/icd.d/nvidia_icd.json ]] &&
        export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json
fi
# DXVK reports NVIDIA GPUs as AMD unless NVAPI is on; Adobe's GPU sniffers need NVIDIA.
export DXVK_ENABLE_NVAPI=1 DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}" VKD3D_DEBUG="${VKD3D_DEBUG:-none}"
export DXVK_STATE_CACHE_PATH="$base/cache/dxvk"
export __GL_SHADER_DISK_CACHE=1 __GL_SHADER_DISK_CACHE_PATH="$base/cache/nvidia"
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
mkdir -p "$base/cache/dxvk" "$base/cache/nvidia" "$WINE_GST_REGISTRY_DIR"

# Keys go to Wine directly, not through the ibus/fcitx XIM bridge, which delays every
# keystroke (laggy typing in text layers). Keyboard layout switching still works; set
# ADOBE_WINE_IM=1 to keep the input method (needed only for CJK-style composed input).
[[ -n "${ADOBE_WINE_IM:-}" ]] || export XMODIFIERS=@im=none

# filedialog.dll (Open/Save dialogs) runs this helper to show the desktop's file chooser;
# its calls are traced to %TEMP%\adobe-filedialog.log (small, only when dialogs open).
export ADOBE_FILECHOOSER="$here/../lib/filechooser.py"
export ADOBE_FILEDIALOG_LOG="${ADOBE_FILEDIALOG_LOG:-1}"

# Proton names every X11 window "steam_proton" unless SteamAppId is set; give each
# Adobe app its own WM_CLASS (steam_app_<Exe>) so the desktop matches it to its launcher.
exe="${1:-}"
exe="${exe##*[\\/]}"
exe="${exe%.[eE][xX][eE]}"
exe="${exe//[^A-Za-z0-9_-]/}"
if [[ -n "$exe" ]]; then
    export SteamAppId="$exe"
    # App start scripts set ADOBE_WINE_LOG: Wine errors and drag-and-drop events go there.
    # (Not for plain commands: tools read the output of cmd, reg, winepath, ...)
    if [[ -n "${ADOBE_WINE_LOG:-}" && "$ADOBE_WINE_LOG" != - ]]; then
        mkdir -p "$(dirname "$ADOBE_WINE_LOG")"
        [[ -f "$ADOBE_WINE_LOG" ]] && mv -f "$ADOBE_WINE_LOG" "$ADOBE_WINE_LOG.1"
        [[ "$WINEDEBUG" == -all ]] && export WINEDEBUG="-all,err+all,trace+xdnd,trace+clipboard"
        exec >> "$ADOBE_WINE_LOG" 2>&1
    fi
    helper="$here/../lib/wm_helper.py"
    if [[ -n "${DISPLAY:-}" && -f "$helper" ]]; then
        # Dark title bars + no shadows on borderless popups (see wm_helper.py).
        env LD_LIBRARY_PATH="$ORIG_LD_LIBRARY_PATH" python3 "$helper" "steam_app_$exe" $$ 2>/dev/null &
        helper_pid=$!
        status=0
        "$WINE" "$@" || status=$?
        kill "$helper_pid" 2>/dev/null || true
        exit "$status"
    fi
fi
exec "$WINE" "$@"
