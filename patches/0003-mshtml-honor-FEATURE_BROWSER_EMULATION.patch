Subject: [PATCH] mshtml: Honor FEATURE_BROWSER_EMULATION for documents with a doctype.

Apps hosting the WebBrowser control (e.g. Adobe NGL sign-in, FEATURE_BROWSER_EMULATION
"AfterFX.exe"=11001) got IE7 mode, where JSON and other IE8+ APIs are missing.
(The binary patch in lib/patch_runner.py simply makes doctype documents default to IE11.)
---
--- a/dlls/mshtml/mutation.c
+++ b/dlls/mshtml/mutation.c
@@ -65,6 +65,23 @@
         cache = ret;
     }
     return ret;
+}
+
+static compat_mode_t browser_emulation_mode(void)
+{
+    static const WCHAR key[] = L"Software\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_BROWSER_EMULATION";
+    const WCHAR *p, *name = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    DWORD value = 0, size = sizeof(value);
+
+    if((p = wcsrchr(name, '\\'))) name = p + 1;
+    if(RegGetValueW(HKEY_CURRENT_USER, key, name, RRF_RT_REG_DWORD, NULL, &value, &size) &&
+       RegGetValueW(HKEY_LOCAL_MACHINE, key, name, RRF_RT_REG_DWORD, NULL, &value, &size))
+        return COMPAT_MODE_INVALID;
+    if(value >= 11000) return COMPAT_MODE_IE11;
+    if(value >= 10000) return COMPAT_MODE_IE10;
+    if(value >= 9000) return COMPAT_MODE_IE9;
+    if(value >= 8000) return COMPAT_MODE_IE8;
+    return value >= 7000 ? COMPAT_MODE_IE7 : COMPAT_MODE_INVALID;
 }
 
 static PRUnichar *handle_insert_comment(HTMLDocumentNode *doc, const PRUnichar *comment)
@@ -917,9 +934,11 @@
 
         nsres = nsIContent_QueryInterface(aContent, &IID_nsIDOMDocumentType, (void**)&nsdoctype);
         if(NS_SUCCEEDED(nsres)) {
-            compat_mode_t mode = COMPAT_MODE_IE7;
+            compat_mode_t mode = browser_emulation_mode();
 
             TRACE("doctype node\n");
+            if(mode == COMPAT_MODE_INVALID)
+                mode = COMPAT_MODE_IE7;
 
             /* Native mshtml hardcodes special behavior for iexplore.exe here. The feature control registry
                keys under HKLM or HKCU\Software\Microsoft\Internet Explorer\Main\FeatureControl are not used
