From c234c4fdeef2a6458c11c79dad3afd82747438e1 Mon Sep 17 00:00:00 2001
From: sobhi <nazimakram13@gmail.com>
Date: Sun, 4 Oct 2026 19:30:05 +0300
Subject: [PATCH 2/2] winmm: The size from DRV_QUERYFUNCTIONINSTANCEIDSIZE is a
 ULONG.

64-bit callers that pass the address of a ULONG got the 4 bytes after it
overwritten with zeros. Adobe After Effects 2020 crashes on start-up
("Initializing MediaCore") because a pointer next to that ULONG is
cleared.
---
 dlls/winmm/tests/wave.c | 2 --
 dlls/winmm/waveform.c   | 6 +++---
 2 files changed, 3 insertions(+), 5 deletions(-)

diff --git a/dlls/winmm/tests/wave.c b/dlls/winmm/tests/wave.c
index 6fb0823..6ae550f 100644
--- a/dlls/winmm/tests/wave.c
+++ b/dlls/winmm/tests/wave.c
@@ -2515,7 +2515,6 @@ static void test_instance_id(void)
     mr = waveOutMessage((HWAVEOUT)0, DRV_QUERYFUNCTIONINSTANCEIDSIZE, (DWORD_PTR)size, 0);
     ok(mr == MMSYSERR_NOERROR, "got %u\n", mr);
     ok(size[0] > sizeof(WCHAR) && size[0] <= sizeof(id), "got size %lu\n", size[0]);
-    todo_wine_if(sizeof(void *) > sizeof(ULONG))
     ok(size[1] == 0xdeadbeef, "got %#lx after the size\n", size[1]);
 
     mr = waveOutMessage((HWAVEOUT)0, DRV_QUERYFUNCTIONINSTANCEID, (DWORD_PTR)id, size[0]);
@@ -2527,7 +2526,6 @@ static void test_instance_id(void)
     size[0] = size[1] = 0xdeadbeef;
     mr = waveInMessage((HWAVEIN)0, DRV_QUERYFUNCTIONINSTANCEIDSIZE, (DWORD_PTR)size, 0);
     ok(mr == MMSYSERR_NOERROR, "got %u\n", mr);
-    todo_wine_if(sizeof(void *) > sizeof(ULONG))
     ok(size[1] == 0xdeadbeef, "got %#lx after the size\n", size[1]);
 }
 
diff --git a/dlls/winmm/waveform.c b/dlls/winmm/waveform.c
index 5b9134d..3b1338c 100644
--- a/dlls/winmm/waveform.c
+++ b/dlls/winmm/waveform.c
@@ -3010,7 +3010,7 @@ UINT WINAPI waveOutGetID(HWAVEOUT hWaveOut, UINT* lpuDeviceID)
     return MMSYSERR_NOERROR;
 }
 
-static UINT WINMM_QueryInstanceIDSize(UINT device, DWORD_PTR *len, BOOL is_out)
+static UINT WINMM_QueryInstanceIDSize(UINT device, ULONG *len, BOOL is_out)
 {
     UINT count;
     WINMM_MMDevice **devices;
@@ -3096,7 +3096,7 @@ UINT WINAPI waveOutMessage(HWAVEOUT hWaveOut, UINT uMessage,
     switch(uMessage){
     case DRV_QUERYFUNCTIONINSTANCEIDSIZE:
         return WINMM_QueryInstanceIDSize(HandleToULong(hWaveOut),
-                (DWORD_PTR*)dwParam1, TRUE);
+                (ULONG*)dwParam1, TRUE);
     case DRV_QUERYFUNCTIONINSTANCEID:
         return WINMM_QueryInstanceID(HandleToULong(hWaveOut), (WCHAR*)dwParam1, dwParam2, TRUE);
     case DRV_QUERYDEVICEINTERFACESIZE:
@@ -3509,7 +3509,7 @@ UINT WINAPI waveInMessage(HWAVEIN hWaveIn, UINT uMessage,
     switch(uMessage){
     case DRV_QUERYFUNCTIONINSTANCEIDSIZE:
         return WINMM_QueryInstanceIDSize(HandleToULong(hWaveIn),
-                (DWORD_PTR*)dwParam1, FALSE);
+                (ULONG*)dwParam1, FALSE);
     case DRV_QUERYFUNCTIONINSTANCEID:
         return WINMM_QueryInstanceID(HandleToULong(hWaveIn), (WCHAR*)dwParam1, dwParam2, FALSE);
     case DRV_QUERYDEVICEINTERFACESIZE:
